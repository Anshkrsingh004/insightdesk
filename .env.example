# ---- LLM provider: mock | ollama | cloud ----
# mock  : deterministic, no model needed (routing, tools, escalation, extractive answers all work)
# ollama: local Ollama (mandated primary).   cloud: disclosed fallback (spec-permitted)
LLM_PROVIDER=mock

# Ollama (primary)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Cloud fallback (OpenAI-compatible: OpenAI / Groq / OpenRouter / local). Disclosed in README.
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# ---- Embeddings: onnx-minilm (default, no torch) | sentence-transformers ----
EMBEDDINGS=onnx-minilm
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Storage ----
SQLITE_PATH=storage/insightdesk.db
CHROMA_DIR=storage/chroma

# ---- Retrieval / policy knobs (policy values also live in SQLite policy_registry) ----
TOP_K=5
CRITIC_MIN_GROUNDEDNESS=0.6
